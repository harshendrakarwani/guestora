NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set Razorpay Dashboard to Test Mode while integrating.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-signing-secret

# Meta WhatsApp Cloud API test setup. Do not expose these as NEXT_PUBLIC_*.
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=guestora_application_approved
WHATSAPP_TEMPLATE_LANGUAGE=en
# Utility template sent after Razorpay confirms an application refund.
WHATSAPP_REFUND_TEMPLATE_NAME=guestora_application_rejected_refund_processed
WHATSAPP_REFUND_TEMPLATE_LANGUAGE=en
# Resend sender used for guest dashboard access links. Verify the sender domain in Resend first.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Guestora <noreply@your-verified-domain.com>
# Comma-separated Guestora admin login emails authorized to review organizer commission claims.
COMMISSION_ADMIN_EMAILS=admin@example.com
# Base64-encoded 32-byte key used to encrypt payout destinations at rest. Keep it stable and private.
COMMISSION_PAYOUT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Set these only after Meta approves the separate image-header QR template.
WHATSAPP_QR_TEMPLATE_NAME=
WHATSAPP_QR_TEMPLATE_LANGUAGE=en
# Approved Authentication OTP template used before guests apply to an event.
WHATSAPP_OTP_TEMPLATE_NAME=guestora_whatsapp_number_verification
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
NEXT_PUBLIC_SITE_URL=https://your-vercel-preview-domain.vercel.app
